# ============================================================
# Smart Bus Stop AI — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ============================================================

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=smartbusstop
DB_PORT=5432

# ── Backend ───────────────────────────────────────────────────
# Full connection URL (auto-built from above in docker-compose)
# Set manually here only if running the backend outside Docker
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/smartbusstop

# Comma-separated list of allowed CORS origins
# For local dev use: ["http://localhost:5173"]
# For production: ["https://your-domain.com"]
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Runtime environment: development | production
APP_ENV=production

# API rate limit (slowapi format)
RATE_LIMIT=60/minute

# Port for the FastAPI server
BACKEND_PORT=8000

# ── Frontend ──────────────────────────────────────────────────
# URL that the browser uses to reach the backend API
# Inside Docker: http://localhost:8000 (mapped from container)
VITE_API_URL=http://localhost:8000

# Port for the Nginx frontend container
FRONTEND_PORT=80
