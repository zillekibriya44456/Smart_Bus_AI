# Smart Bus Stop AI — Backend Environment Variables
#
# Copy to backend/.env for local development (without Docker):
#   cp backend/.env.example backend/.env

# Database connection (default: local PostgreSQL)
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/smartbusstop

# CORS — list of allowed frontend origins
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Runtime environment: development | production
APP_ENV=development

# Rate limiting (slowapi format)
RATE_LIMIT=60/minute
